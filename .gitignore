# C++ build output
build/
cpp/build/
cpp/build-msvc/
build-msvc/
*.obj
*.o
*.exe
*.pdb
*.ilk

# Python
__pycache__/
*.pyc
.venv/
venv/

# Generated data. Every generator is deterministic in (type, n, seed, params),
# so datasets/results are reproducible from the CLI and not worth versioning.
# Keep only the demo fixtures and directory placeholders.
datasets/*
!datasets/.gitkeep
!datasets/demo/
!datasets/demo/**
!datasets/real/
!datasets/real/.gitkeep
datasets/real/**
!datasets/real/.gitkeep

results/*
!results/.gitkeep

# Local copies of research papers.
# Bibliographic metadata and hashes remain version-controlled in papers/README.md.
papers/primary/*.pdf

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
