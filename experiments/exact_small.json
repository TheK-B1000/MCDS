      "uniform",
      "clustered",
      "perturbed_grid",
      "corridor",
      "cluster_bridge"
    ],
    "sizes": [
      10,
      13,
      16
    ],
    "densities": [
      3.0,
      5.0,
      8.0
    ],
    "radius": 1.0,
    "replicates": 24,
    "geometry_parameters": {
      "clustered": {
        "clusters": 2,
        "spread": 0.8
      },
      "corridor": {
