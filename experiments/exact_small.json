{
  "study_id": "exact_small",
  "study_seed": 20261007,
  "description": "RQ10: empirical approximation ratio |D|/OPT on instances small enough for exhaustive exact search (n <= 16). Results describe these small instances only and say nothing about the papers' theoretical ratios.",
  "algorithms": [
    "marathe",
    "wan",
    "funke",
    "li"
  ],
  "spatial_backend": "cgal",
