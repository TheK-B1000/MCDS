  "timing": {
    "repetitions": 1,
    "warmups": 0,
    "instrumentation": "none",
    "process_mode": "shared",
    "validate": "all",
    "timeout_seconds": 600
  },
  "memory_probe": false,
  "counter_pass": null,
  "exact": {
