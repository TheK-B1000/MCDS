{
  "study_id": "precision_pilot",
  "study_seed": 20261010,
  "description": "Precision pilot: justifies the final replicate count. Representative cells (all five geometries, two sizes, middle density) with 40 independent graphs each; read precision_curve.csv (CI half-width of paired differences vs k graphs). Pilot outcomes may inform the protocol; final outcomes may not.",
  "algorithms": [
    "marathe",
    "wan",
    "funke",
    "li"
  ],
  "spatial_backend": "cgal",
  "synthetic": {
    "geometries": [
      "uniform",
      "clustered",
      "perturbed_grid",
      "corridor",
      "cluster_bridge"
    ],
    "sizes": [
      1000,
      5000
    ],
    "densities": [
      8.0
    ],
    "radius": 1.0,
    "replicates": 40,
    "geometry_parameters": {
      "clustered": {
        "clusters": 4,
        "spread": 0.8
      },
      "corridor": {
        "corridor_width": 3.0
      },
      "cluster_bridge": {
        "clusters": 3,
        "spread": 0.45,
        "bridge_fraction": 0.2,
        "bridge_width": 0.6
      },
      "perturbed_grid": {
        "jitter": 0.15
      }
    }
  },
  "connectivity_rule": {
    "mode": "resample_until_connected",
    "max_attempts": 80
  },
  "timing": {
    "repetitions": 3,
    "warmups": 1,
    "instrumentation": "none",
    "process_mode": "shared",
    "validate": "all",
    "timeout_seconds": 1800
  },
  "memory_probe": false,
  "counter_pass": null,
  "exact": {
    "max_n": 0,
    "timeout_seconds": 600
  }
}
